# Public mirror .gitignore - Python tool. Contributors build/run locally; nothing generated ships.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ruff_cache/

# Local env / secrets never belong in the repo.
.env
.env.*
*.pem
*.key

# Scan output is generated, not source.
/data/output/*
!/data/output/.gitkeep
